; Engine configuration file.
; Godot 4.6 プロジェクト設定。エディタの「プロジェクト設定」を保存するとここが書き換わる。
; 手で書いた項目もエディタで確認・変更できる。

config_version=5

[application]

config/name="Kazegahukeba"
config/description="終わりゆく世界の最後の夏を過ごす2DドットADV/RPG（骨組み版）"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

; ゲーム全体の状態を持つシングルトン。全シーンから GameState.xxx で参照できる。
GameState="*res://autoload/GameState.gd"
; 操作キーの登録（起動時に一度だけ）。
Controls="*res://autoload/Controls.gd"
; 周回をまたいで残るセーブ記録（到達エンド・周回数）。
SaveData="*res://autoload/SaveData.gd"
; BGM／効果音（音源が無ければコード合成で鳴らす）。
AudioManager="*res://autoload/AudioManager.gd"
; シーン遷移（街 ⇄ 場所）の入口。
Nav="*res://autoload/Nav.gd"
; カレンダー等の常時UI。シーンをまたいで表示し続けるため Autoload（シーン）にする。
; GameState のシグナルを購読するので、GameState より後に登録する。
HUD="*res://scenes/HUD.tscn"
; 会話ウィンドウ。全シーンから Dialogue.start([...]) で呼べる。
Dialogue="*res://autoload/Dialogue.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; 日本語表示のためのフォント。assets/fonts に .ttf を置いて有効化する（README 参照）。
; フォント未設置でも起動はするが、日本語が □（豆腐）になる。
theme/custom_font="res://assets/fonts/NotoSansJP-Regular.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
