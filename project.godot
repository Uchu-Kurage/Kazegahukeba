; Engine configuration file.
; Godot 4.6 プロジェクト設定。エディタの「プロジェクト設定」を保存するとここが書き換わる。
; 手で書いた項目もエディタで確認・変更できる。

config_version=5

[application]

config/name="Kazegahukeba"
config/description="終わりゆく世界の最後の夏を過ごす2DドットADV/RPG（骨組み版）"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

; ゲーム全体の状態を持つシングルトン。全シーンから GameState.xxx で参照できる。
GameState="*res://autoload/GameState.gd"
; 操作キーの登録（起動時に一度だけ）。
Controls="*res://autoload/Controls.gd"
; 周回をまたいで残るセーブ記録（到達エンド・周回数）。
SaveData="*res://autoload/SaveData.gd"
; BGM／効果音（音源が無ければコード合成で鳴らす）。
AudioManager="*res://autoload/AudioManager.gd"
; シーン遷移（街 ⇄ 場所 ⇄ 終幕 ⇄ タイトル）の入口。
Nav="*res://autoload/Nav.gd"
; 画面遷移のフェード（黒幕の暗転／明転）。
Fader="*res://autoload/Fader.gd"
; カレンダー等の常時UI。シーンをまたいで表示し続けるため Autoload（シーン）にする。
; GameState のシグナルを購読するので、GameState より後に登録する。
HUD="*res://scenes/HUD.tscn"
; 予定表＝約束帳（いつでも開ける常設ビュー）。GameState のシグナルを購読するので後に置く。
Book="*res://scenes/Book.tscn"
; かばん＝所持品（夏の道具）の専用UI。予定帳とは別立て。GameState のシグナルを購読するので後に置く。
Bag="*res://scenes/Bag.tscn"
; 会話ウィンドウ。全シーンから Dialogue.start([...]) で呼べる。
Dialogue="*res://autoload/Dialogue.gd"
; スマホ（タッチ端末）向けの画面上コントローラ。移動/決定/戻る/デバッグメニューを
; 既存の入力アクションへ橋渡しする。Controls（アクション登録）より後に置く。
TouchControls="*res://autoload/TouchControls.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; 日本語表示のためのフォント。丸ゴシック（M PLUS Rounded 1c）を主に、収録外の字は Noto Sans JP で補う。
; 組み合わせは assets/fonts/ui_font.tres（FontVariation＋fallbacks）で定義（README 参照）。
theme/custom_font="res://assets/fonts/ui_font.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
