# Godot 4 の公式推奨に沿った除外設定。
# インポート済みアセットのバイナリキャッシュ。エディタが自動生成するのでコミットしない。
.godot/

# Android ビルドテンプレート（使うようになったら調整）
/android/

# エクスポート成果物（Web など）。CI やエディタが生成するのでコミットしない。
/build/

# OS / エディタのゴミ
.DS_Store
*.tmp

# 注意: アセット横の *.import と *.uid はコミットする（UID を共有して壊れないようにするため）。
# エディタで初回起動すると生成されるので、その後まとめてコミットするとよい。
