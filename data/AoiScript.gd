	return [
		{ "speaker": "", "text": "河原に降りると、風が水の匂いを運んできた。" },
		{ "speaker": "", "text": "日が傾きはじめて、川面がぜんぶ、オレンジに光っている。" },
		{ "speaker": "", "text": "葵は、水際にしゃがんでいた。石を一つ、手のなかで転がしている。" },
		{ "speaker": AOI, "text": "あ、来た。……って、もう言うのやめよっかな。キミ毎回来るから。" },
		{ "speaker": "", "text": "そう言って、葵は手の中の石を、川に投げた。ぽちゃん、と音がして、波紋が広がって、すぐ流れに消えた。" },
		{ "speaker": AOI, "text": "ねえ、知ってる? この水さ、ここにあるの今だけなんだよ。" },
		{ "speaker": AOI, "text": "さっき見てた水は、もう海の方。次の水が、今ここにいる。" },
		{ "choices": [
			{ "text": "「川ってそういうものだろ」", "lean": Endings.LEAN_WARMTH, "then": [
				{ "speaker": AOI, "text": "そうだよ。だからいいんじゃん。" },
				{ "speaker": "", "text": "葵はこっちを見ずに、流れを見たまま言った。" },
				{ "speaker": AOI, "text": "ずっと同じ水が居座ってたら、それ、川じゃなくて池でしょ。" },
			] },
			{ "text": "葵の隣にしゃがむ", "lean": Endings.LEAN_CLOSENESS, "then": [
				{ "speaker": "", "text": "僕は、葵の隣にしゃがんだ。" },
				{ "speaker": "", "text": "水面がすぐ近くにあって、オレンジの光が、ちらちら揺れていた。" },
				{ "speaker": AOI, "text": "……なに、キミも石投げる?" },
				{ "speaker": "", "text": "葵は、手ごろな石を一つ、僕の方へ差し出した。" },
			] },
			{ "text": "「なんだか、寂しい話だな」", "lean": Endings.LEAN_SHADOW, "then": [
				{ "speaker": AOI, "text": "え、そう?" },
				{ "speaker": "", "text": "葵は、意外そうな顔で僕を見た。" },
				{ "speaker": AOI, "text": "寂しくないよ。だって、今ここにある水は、ちゃんと今ここにあるじゃん。" },
				{ "speaker": "", "text": "それはそうだ、と思った。でも、うまく言い返せなかった。" },
			] },
		] },
		{ "speaker": "", "text": "葵は、また一つ石を拾って、投げた。" },
		{ "speaker": "", "text": "波紋が広がって、消える。オレンジの川は、何ごともなかったみたいに、流れつづけていた。" },
		{ "speaker": AOI, "text": "あたしね、こういう時間が、いちばん好き。" },
		{ "speaker": AOI, "text": "夕方。もうすぐ終わるんだけど、まだ終わってない。この、あいだの時間。" },
		{ "speaker": "", "text": "まだ終わってない、と葵は言った。" },
		{ "speaker": "", "text": "その横顔が、沈む日の光で、ふちどりされていた。僕はなぜか、目をそらせなかった。" },
	]


# --- 日常3｜自販機・昼（軽い回）----------------------------------------
static func _vending() -> Array:
	return [
		{ "speaker": "", "text": "商店街の外れ、自販機の前。アスファルトが陽炎でゆれている。蝉の声が、頭の上から降ってくる。" },
		{ "speaker": "", "text": "葵は、自販機に百円玉を入れたまま、腕を組んで唸っていた。" },
		{ "speaker": AOI, "text": "うーん……。あ、来た。ねえ、ちょっと、これ見て。決められない。" },
		{ "speaker": "", "text": "葵が指さしたのは、自販機のボタンの列。ラムネ味のソーダと、よく分からない色の新商品が、並んで光っている。" },
		{ "speaker": AOI, "text": "こっちは知ってる味。こっちは知らない味。どっちがいいと思う?" },
		{ "choices": [
			{ "text": "「知ってる味にしとけ」", "lean": Endings.LEAN_SHADOW, "then": [
				{ "speaker": AOI, "text": "えー、キミ、そういうタイプ?" },
				{ "speaker": "", "text": "葵は、心底意外だ、という顔をした。" },
				{ "speaker": AOI, "text": "もったいないよ。知ってる味なんて、いつでも飲めるじゃん。" },
			] },
			{ "text": "「知らない方を選べよ」", "lean": Endings.LEAN_WARMTH, "then": [
				{ "speaker": AOI, "text": "でしょ! あたしもそう思ってた。" },
				{ "speaker": "", "text": "葵は嬉しそうに、迷わず新商品のボタンを押した。" },
				{ "speaker": AOI, "text": "やっぱそうだよね。知らないものは、飲んどかないと。" },
			] },
			{ "text": "黙って、自分のぶんを買う", "lean": Endings.LEAN_CLOSENESS, "then": [
				{ "speaker": "", "text": "僕は葵の横で、いつものラムネソーダのボタンを押した。がこん、と缶が落ちる音。" },
				{ "speaker": AOI, "text": "ちょっと。人が悩んでる横で、勝手に買うな。" },
				{ "speaker": "", "text": "そう言いながら、葵はちょっと笑っていた。" },
			] },
		] },
		{ "speaker": "", "text": "結局、葵は新商品の方を押した。がこん、と落ちてきた缶を拾って、勢いよくプルタブを開ける。" },
		{ "speaker": AOI, "text": "……うわ。なにこれ。微妙。" },
		{ "speaker": "", "text": "変な顔をしていた。でも、もう一口飲んだ。" },
		{ "speaker": AOI, "text": "でも、まあ、いいや。知らない味、ひとつ知れたし。" },
		{ "speaker": "", "text": "炭酸のはじける音と、蝉の声。それだけの、なんでもない昼だった。" },
		{ "speaker": "", "text": "僕はたぶん、こういう日のことを、あとでいちばん思い出すんだろうな、と思った。" },
	]


# --- 日常4｜丘のベンチ（少し特別な時間）--------------------------------
