class_name AoiScript
extends RefCounted
## 葵ルートの本文（実装指示 第8弾 §1）。`葵ルート_本文.md` の台本を実装データ化した層。
##
## Dialogues.route_script(Routes.AOI, key) からここへ委譲する（Dialogues を肥らせない）。
## 記法変換（本文テキスト仕様）：〔ナレ〕→話者なし、【葵】→"葵"、【町の人】→"町の人"。
## 主人公は無言（本文の指定）＝プレイヤーのセリフは選択肢そのもの＋その後のナレで受ける。
## 一人称は本文に合わせて「僕」。
##
## ◆選択肢は「差分→合流」構造：選択ノードの各 then が差分、選択ノードの“次”以降が合流点。
##   （Dialogue が then を差し込み、その後もとの後続ノード＝合流へ流れる仕組みを使う。）
##
## ★三分岐の布石（§1-3 / §2-2）：各選択肢に中立な「傾き」タグ lean を付ける。
##   lean は方向のみを記録する（量＝スコアではない）。タグ値は Endings に定数化（直書き禁止）。
##     Endings.LEAN_WARMTH    … 明るさ・楽しさを一緒に膨らませる方向
##     Endings.LEAN_SHADOW    … 寂しさ・終わりに寄り添う方向
##     Endings.LEAN_CLOSENESS … 距離を縮める・二人だけの親密さを育てる方向
##   着地(8/31)は最も高い方向のエンドへ（Endings._aoi_ending）。優劣・正解・失敗はない。
##
## ⚠️ 二層構造の厳守：葵は最後まで「明るく親しみやすい普通の夏の娘」。正体は一切匂わせない。
##   変数名・コメント・仮テキスト・内部IDのどこにも「化身」「正体」等を出さない。

const AOI := "葵"
const TOWN := "町の人"


## 節目・日常シーンの台本を引く（key は Routes の葵ルート milestone.key）。
static func scene(key: String) -> Array:
	match key:
		"meet":    return _meet()
		"around":  return _kawara()
		"dodge":   return _vending()
		"closer":  return _hill_bench()
		"shadow":  return _first_shadow()
		"stance":  return _stance()
		"turning": return _promise()
		"lastday": return _last_meeting()
	return []


# --- 日常1｜ひまわり畑・邂逅（基準シーン）--------------------------------
## ※ 完全版は `本文テキスト仕様と基準シーン.md`。ここは要約からの仮置き（本文追記時に差し替え）。
static func _meet() -> Array:
	return [
		{ "speaker": "", "text": "畦道の脇道に、ひまわり畑があった。見わたすかぎり、黄色。その真ん中に、女の子が立っていた。" },
		{ "speaker": AOI, "text": "あ、来た。……って、なんか、待ってたみたいだね、いまの。変なの。" },
		{ "speaker": "", "text": "まるで、ずっとそこで、誰かを待っていたような顔で、その子は笑った。" },
		{ "speaker": AOI, "text": "ねえ、知ってる? ひまわりって、若いうちだけ太陽を追いかけるんだって。大きくなると、東を向いて、もう動かないの。" },
		{ "choices": [
			{ "text": "「太陽の方を向くんだ」", "lean": Endings.LEAN_WARMTH, "then": [
				{ "speaker": AOI, "text": "そう! ずっと、いちばん明るい方をね。……いいと思わない? そういうの。" },
			] },
			{ "text": "そっと、花に近づく", "lean": Endings.LEAN_CLOSENESS, "then": [
				{ "speaker": "", "text": "僕が花に近づくと、その子も、すぐ隣に並んだ。肩が触れそうな近さだった。" },
				{ "speaker": AOI, "text": "ふふ。おそろいだね、これで。" },
			] },
			{ "text": "「もう動かないのか」", "lean": Endings.LEAN_SHADOW, "then": [
				{ "speaker": AOI, "text": "うん。動かない。……でも、それって、いる場所を決めた、ってことでしょ。悪くないよ。" },
			] },
		] },
		{ "speaker": AOI, "text": "あたし、葵。過去とか未来とか、あんまり考えないんだ。今、ここにいる。それが全部でしょ?" },
		{ "speaker": "", "text": "まぶしい光の中で、その子は、そう言いきった。〔仮テキスト：基準シーン本文で差し替え〕" },
	]


# --- 日常2｜河原・夕暮れ ------------------------------------------------
