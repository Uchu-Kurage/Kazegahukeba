# --- 8/31 の三分岐エンディング（Endings から呼ぶ）----------------------
## §2-1：三つは対等。優劣・正解・失敗はない。変わるのは別れの温度と、葵が最後に見せる一面。
## §2-4：中身の台本は後日 `葵ルート_本文.md` に追記。ここは骨子（仮）＋共通の余韻。
## 着地の原則：別れの言葉なし・正体を明かさない・誰も覚えていない余韻（§0/§5）。
static func ending(end_id: String) -> Array:
	var head: Array = []
	match end_id:
		Endings.AOI_END_HIMAWARI:
			# 輝きの恋「夏を、夏のまま」。最も輝ける始まりの場所で、夏の絶頂をもう一度なぞる。
			head = [
				{ "speaker": "", "text": "ひまわり畑。盛りを過ぎてなお、その一角だけ、まぶしいくらいに咲いていた。" },
				{ "speaker": AOI, "text": "来た! ねえ、今日はさ、とことん楽しもう。夏を、夏のまんま。" },
				{ "speaker": "", "text": "最後まで、葵はまぶしかった。二人は、光の中で、声をあげて笑った。〔骨子・仮〕" },
			]
		Endings.AOI_END_HILL:
			# 見届ける恋「終わりを、共に」。失われる世界のすべてが見える場所で、共に終わりを見る。
			head = [
				{ "speaker": "", "text": "丘の上。町のぜんぶが、夕日に染まっていた。屋根も、川も、田んぼも、静かに光っている。" },
				{ "speaker": AOI, "text": "ここなら、ぜんぶ見えるでしょ。……最後まで、いっしょに見ててくれる?" },
				{ "speaker": "", "text": "二人は、終わっていく町を、ただ静かに、見ていた。〔骨子・仮〕" },
			]
		Endings.AOI_END_HOME:
			# 寄り添う恋「ただ、あなたのそばで」。特別な場所ではなく“あなたの日常”に入りたい願い。
			# ※消極的選択ではない。最も積極的で切ない願い（§2-1）。取り違え厳禁。
			head = [
				{ "speaker": "", "text": "家の縁側。麦茶のグラスに、汗がつたう。風鈴が、ちりん、と鳴った。" },
				{ "speaker": AOI, "text": "あのさ。あたし、こういうの、いっかい、してみたかったんだ。……なんでもない日を。キミの、となりで。" },
				{ "speaker": "", "text": "特別な場所じゃない、ただの午後。葵は、ただの女の子の顔で、笑っていた。〔骨子・仮〕" },
			]
	head.append_array(ending_aftermath())
	return head


## 三分岐で共通の余韻（本文「着地・別れ」後半）。別れの言葉なく葵は消え、町の誰も覚えていない。
## 宙吊りの謎＝裏エンドへの伏線をどのエンドでも残す（§0）。
static func ending_aftermath() -> Array:
	return [
		{ "speaker": "", "text": "——気づけば、葵は、いなくなっていた。別れの言葉も、なかった。" },
		{ "speaker": "", "text": "次の日も、その次の日も。ひまわり畑にも、丘にも、河原にも、どこにも、いなかった。" },
		{ "speaker": "", "text": "商店街のおばちゃんに、聞いてみた。明るくて、よく笑う、この夏ずっと町にいた子のことを。" },
		{ "speaker": TOWN, "text": "……葵ちゃん? はて。そんな子、いたかねえ。" },
		{ "speaker": "", "text": "別の人にも聞いた。その人も、首をかしげた。誰も、葵を、覚えていなかった。あんなに、どこにでもいた子を。" },
		{ "speaker": "", "text": "河原に戻って、葵が最後に座っていた場所に、座ってみた。川は、あの日と同じように、流れていた。さっきの水は、もう海の方。次の水が、今ここにいる。" },
		{ "speaker": "", "text": "あの子が、何だったのか。どこから来て、どこへ行ったのか。なぜ、誰も覚えていないのか。なぜ、僕だけが、覚えているのか。" },
		{ "speaker": "", "text": "何も、分からなかった。ただ、いなくなった。それだけが、本当だった。" },
		{ "speaker": "", "text": "蝉の声が、少なくなっていた。風に、冷たいものが、混じりはじめていた。夏が、終わろうとしていた。" },
		{ "speaker": "", "text": "また、ね。あの日の、葵の声が、耳の奥で、まだ、鳴っていた。——また、会えるだろうか。" },
	]
