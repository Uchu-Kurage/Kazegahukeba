class_name UraStory
extends RefCounted
## 裏エンド（9月1日）の場面データ（実装指示 第5弾）。
##
## これまでの40日ループとは別物。枠・関係値・ルート判定・Story.gd のイベント解決器は使わない。
## 「順に流れる一本道」の最終章。各場面は tone（背景トーン）と nodes（会話ノード）を持つデータ。
## UraEnding シーンが上から順に再生するだけ。テキストは仮置き。
##
## ★禁欲（最重要）：葵の正体を、ナレーション・台詞・地の文で説明しない。「夏の化身」と言わない。
##   符合を静かに並べるだけ。繋げるのはプレイヤーの仕事。プレイヤーへの直接の語りかけもしない
##   （主人公が覚えている、という事実だけで伝える）。境界が溶ける演出は、今は入れない。

const PLAYER := "ぼく"


## 場面の並び（上から順に再生）。tone は UraBackground の背景トーン名。
static func scenes() -> Array:
	return [
		# 1. 朝・目覚め（層1：秋が来たことの静かな驚き）
		{ "id": "morning", "tone": "dawn", "nodes": [
			{ "speaker": "", "text": "目が覚めると、空気が少し違った。" },
			{ "speaker": "", "text": "白く褪せた夏の空ではない。高く、澄んだ青。蝉の声が、ずいぶん減っている。" },
			{ "speaker": PLAYER, "text": "……９月が、来た。" },
			{ "speaker": "", "text": "ずっと来なかった、夏の次の日。カレンダーの、その先のページ。" },
		]},
		# 2. 町を歩く（秋の町／葵の不在に気づき始める）
		{ "id": "town", "tone": "town", "nodes": [
			{ "speaker": "", "text": "町に出ると、消えたはずの道が、ちゃんとそこにあった。人々も、秋の風を噛みしめている。" },
			{ "speaker": "", "text": "誰もが「来た」という顔をしている。当たり前の翌日が、奇跡みたいに。" },
			{ "speaker": PLAYER, "text": "……そういえば、あの子は。" },
			{ "speaker": "", "text": "いつもどこかにいた、あの子の姿が、どこにもない。" },
		]},
		# 3. 球磨／由布との再会（それぞれ生きている・葵を覚えていない・主人公だけ覚えている＝層2）
		{ "id": "reunion", "tone": "reunion", "nodes": [
			{ "speaker": "球磨", "text": "よう。……なんだ、変な顔して。秋だな、ついに。" },
			{ "speaker": PLAYER, "text": "……なあ。あの子は。いつも一緒にいた、あの女の子は。" },
			{ "speaker": "球磨", "text": "あの子？　……はて。そんな子、いたっけか。" },
			{ "speaker": "由布", "text": "女の子？　……ごめん、わたしも、覚えがないな。" },
			{ "speaker": "", "text": "二人とも、忘れている。覚えているのは、ぼくだけだ。" },
		]},
		# 4. 葵のいた場所を巡る（符合を“並べる”。繋げて説明しない＝§4）
		{ "id": "places", "tone": "places", "nodes": [
			{ "speaker": "", "text": "夏に、あの子と歩いた場所を辿る。" },
			{ "speaker": "", "text": "――そういえば、あの子は、どこにでもいた。川原にも、境内にも、祭りの人混みにも。" },
			{ "speaker": "", "text": "――どこから来たの、と聞くたび、いつも笑ってはぐらかした。" },
			{ "speaker": "", "text": "――初めて会った気がしなかった。どこか、懐かしかった。" },
			{ "speaker": "", "text": "――『過去も先も、あんまり意味ない。今、ここにいる。それが全部でしょ』。そう、言っていた。" },
			{ "speaker": "", "text": "――線香花火の最後の一瞬を、やけにじっと見つめて、『……終わっちゃうね』と。" },
		]},
		# 5. 悼みと呟き（層3：一人で悼む。名指ししない、でも全てを分かった呟き）
		{ "id": "mourn", "tone": "mourn", "nodes": [
			{ "speaker": "", "text": "秋の光の中で、それらが、ひとりでに、腑に落ちていく。言葉には、しないまま。" },
			{ "speaker": PLAYER, "text": "……ああ。" },
			{ "speaker": "", "text": "誰も覚えていない。だから、ぼくが、覚えている。" },
			{ "speaker": PLAYER, "text": "……ありがとう。君がいた夏を、僕は忘れない。" },
		]},
		# 6. 秋を生きる（失われた夏を抱えて、前へ。物語の結末）
		{ "id": "forward", "tone": "forward", "nodes": [
			{ "speaker": "", "text": "空は高い。明日は、９月２日が来る。その次の日も、きっと。" },
			{ "speaker": "", "text": "同じ夏は、二度と来ない。" },
			{ "speaker": PLAYER, "text": "……それでも、前へ。" },
			{ "speaker": "", "text": "失くした夏を抱えて、主人公は、続いていく季節の中を歩き出した。" },
		]},
	]
