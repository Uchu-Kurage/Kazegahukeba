	return [
		{ "speaker": "", "text": "夏の、初めの日だった。" },
		{ "speaker": "", "text": "川原に行くと、もう、いつもの二人がいた。" },
		{ "speaker": "", "text": "球磨は、川に向かって、大きく伸びをしていた。由布は、その少し後ろで、日傘の下に座っている。" },
		{ "speaker": KUMA, "text": "お、来た来た。おせえよ、お前。" },
		{ "speaker": "", "text": "球磨は振り返って、にっと笑った。日に灼けた顔が、真夏の光に、よく似合っていた。" },
		{ "speaker": KUMA, "text": "見ろよ、この空。今年もちゃんと、夏が来やがった。" },
		{ "speaker": YUFU, "text": "……毎年、同じこと言ってるよ。球磨は。" },
		{ "speaker": "", "text": "由布が、くすっと笑った。日傘のふちで、光がやわらかく揺れた。" },
		{ "choices": [
			{ "text": "「相変わらずだな、球磨は」", "then": [
				{ "speaker": "", "text": "相変わらずだ、と僕は思った。" },
				{ "speaker": KUMA, "text": "あ? 相変わらずで悪いか。" },
				{ "speaker": "", "text": "球磨は口をとがらせたけど、すぐにまた笑った。" },
				{ "speaker": KUMA, "text": "いいんだよ、夏は。毎年おんなじで。それが、いいんだろ。" },
			] },
			{ "text": "由布の隣に座る", "then": [
				{ "speaker": "", "text": "僕は、由布の隣に座った。日傘の影が、少しだけ涼しい。" },
				{ "speaker": YUFU, "text": "……ふふ。こっち来た。" },
				{ "speaker": YUFU, "text": "球磨は、ああやってはしゃいでるのが、いちばん球磨らしいけどね。" },
			] },
			{ "text": "空を見上げる", "then": [
				{ "speaker": "", "text": "僕は、空を見上げた。青が、目に痛いくらいだった。" },
				{ "speaker": "", "text": "入道雲が、川の向こうに、山みたいに高くそびえていた。" },
				{ "speaker": KUMA, "text": "だろ? すげえ空だろ。こういう日は、なんでもできる気がすんだよ。" },
			] },
		] },
		{ "speaker": "", "text": "球磨は、川べりの石に、どかっと腰を下ろした。" },
		{ "speaker": "", "text": "そして、川の流れの、ずっと向こう——下流の方を、まっすぐに見た。" },
		{ "speaker": KUMA, "text": "なあ。俺さ、決めてるんだ。" },
		{ "speaker": KUMA, "text": "この町を、出る。" },
		{ "speaker": "", "text": "唐突だった。でも、球磨の声は、本気だった。" },
		{ "speaker": KUMA, "text": "ここじゃないどこかで、でっかいことをやる。絶対にだ。" },
		{ "speaker": "", "text": "どこで、何をやるのか。それは、言わなかった。" },
		{ "speaker": "", "text": "たぶん、球磨自身も、分かっていない。ただ、遠くを、見ていた。" },
		{ "speaker": YUFU, "text": "……また、それ。" },
		{ "speaker": "", "text": "由布の声が、少しだけ、低くなった気がした。" },
		{ "speaker": YUFU, "text": "あたしは、ずっとこの町にいたいけどな。" },
		{ "speaker": "", "text": "由布は、そう言って、足元の小石を、ひとつ、拾った。" },
		{ "speaker": "", "text": "球磨は遠くを見て、由布は足元を見ている。" },
		{ "speaker": "", "text": "二人のあいだで、僕は、どちらを見ればいいのか、分からなかった。" },
	]


# --- 日常2｜商店街・あがきの始まり（空回りの可笑しさ）--------------------
## 選択肢1/3＝球磨のあがきに乗る＝ push（あがき並走）方向の芽。選択肢2＝諫める（中立）。
