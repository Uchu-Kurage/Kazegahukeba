	return [
		{ "speaker": "", "text": "商店街を歩いていたら、球磨に呼び止められた。" },
		{ "speaker": KUMA, "text": "お、ちょうどいい。ちょっと来い。" },
		{ "speaker": "", "text": "球磨は、なにやら古い紙の束を抱えていた。由布も、少し離れて、呆れ顔で立っている。" },
		{ "speaker": KUMA, "text": "聞いてくれ。俺、調べてんだ。この町が、なんで消えねえようにできないか。" },
		{ "speaker": "", "text": "球磨は、紙の束を、僕の前に広げた。古い地図や、町の言い伝えを書き写したものらしい。" },
		{ "speaker": KUMA, "text": "昔の人がさ、なんか残してるはずなんだよ。こういう時の、切り抜け方をさ。" },
		{ "speaker": YUFU, "text": "……球磨。それ、公民館の郷土資料。勝手に持ち出したら、怒られるよ。" },
		{ "speaker": KUMA, "text": "借りたんだよ、ちゃんと! ……たぶん。" },
		{ "choices": [
			{ "text": "「なにか、見つかったのか」", "count": { Endings.KUMA_PUSH: 1 }, "then": [
				{ "speaker": KUMA, "text": "いや、まだ。でも、ぜってえ何かあるって。" },
				{ "speaker": "", "text": "球磨は、目を輝かせていた。根拠はなさそうだった。" },
				{ "speaker": KUMA, "text": "諦めたら、そこで終わりだろ。俺は、終わりたくねえの。" },
			] },
			{ "text": "「無駄だと思うけどな」", "then": [
