class_name PromiseEvents
extends RefCounted
## 予定どおりの約束イベント（予定表＝約束帳の続き）。
##
## 誘いに「応じる」と予定表に約束が記帳される（Dialogues._invite が event ID を持たせる）。
## 約束した日・場所・時間帯にその相手を訪ねると、Story がここの台本を節目・日常より優先して流し、
## 末尾で約束を「果たした」にする。＝「守ったこと」が、その日だけの特別な時間として返ってくる。
##
## 台本の書式は Dialogues と同じ（if_flag などの条件ノードも Story.flatten が展開する）。
## 約束の種類を増やす＝Dialogues._invite_chain に event ID 付きの誘いを足し、ここに台本を足すだけ。
## テキストは仮置き（〔仮テキスト〕）。


## event ID → 台本。未登録（旧セーブの約束など）はキャラごとの汎用台本に落とす。
static func script_for(event_id: String, character: String) -> Array:
	match event_id:
		"kuma_fishing":
			return [
				{ "speaker": "", "text": "〔仮テキスト〕約束どおり、午後の川原へ。球磨はもう竿を二本、石に立てかけて待っていた。" },
				{ "speaker": "球磨", "text": "お、ちゃんと来たな！　ほら、おまえの竿。エサはミミズな、文句言うなよ。" },
				{ "speaker": "", "text": "並んで糸を垂らす。浮きは、なかなか沈まない。セミの声と、川の音だけがある。" },
				{ "speaker": "球磨", "text": "……釣れねえなあ。ま、いいんだよ。こうしてんのが、いいんだ。" },
				{ "speaker": "", "text": "夕方近く、球磨の浮きがやっと沈んだ。上がったのは、手のひらほどの小さな魚だった。" },
				{ "speaker": "球磨", "text": "ちっせえ！　……でも、今日いちばんの大物だな。逃がしてやろうぜ。" },
			]
		"kuma_night_fishing":
			return [
				{ "speaker": "", "text": "〔仮テキスト〕日が傾くころ、約束の川原へ。球磨は懐中電灯をぐるぐる回して手を振った。" },
				{ "speaker": "球磨", "text": "来た来た！　夜釣りはな、暗くなる前の準備が勝負なんだよ。" },
				{ "speaker": "", "text": "空が群青に沈んでいく。水面に、ひとつ、ふたつと、星が落ちてきたように映る。" },
				{ "speaker": "球磨", "text": "……なあ。こういうの、ずっとやってられたらいいのにな。" },
				{ "speaker": "", "text": "返事のかわりに、浮きが小さく揺れた。二人で、息をひそめてそれを見ていた。" },
			]
		"kuma_to_sea":
			return [
				{ "speaker": "", "text": "〔仮テキスト〕朝。約束どおり川原へ行くと、球磨は自転車にまたがって待っていた。" },
				{ "speaker": "球磨", "text": "よし。行くぞ、海まで。川をずっと下ってけば、着くはずなんだ。" },
				{ "speaker": "", "text": "川沿いの道を、どこまでも漕いだ。田んぼが途切れ、家がまばらになり、風に潮の匂いが混じりはじめる。" },
				{ "if_flag": "world_kuma_drifting", "then": [
					{ "speaker": "球磨", "text": "……最近さ、ちょっと遠くなってたろ、おれ。……悪かったな。今日は、ちゃんと隣にいるからさ。" },
				] },
				{ "speaker": "", "text": "やがて、川がひらけた。その先に、光る線が見えた。" },
				{ "speaker": "球磨", "text": "……ほんとに、あったな。海。ガキの頃の約束、ちゃんと守れた。" },
			]
		"yufu_show_place":
			return [
				{ "speaker": "", "text": "〔仮テキスト〕夕方、約束どおり神社の石段を上る。由布は鳥居の下で、少しだけ髪を直していた。" },
				{ "speaker": "由布", "text": "……来てくれたのね。うん。じゃあ、ついてきて。" },
				{ "speaker": "", "text": "社の裏の細い道を抜けると、町が見下ろせる小さな崖の上に出た。夕日が、屋根という屋根を染めている。" },
				{ "speaker": "由布", "text": "ここ、わたしだけの場所だったの。……誰かに見せたのは、はじめて。" },
				{ "speaker": "", "text": "二人で、日が沈みきるまで、黙って町を見ていた。" },
			]
		"yufu_continuation":
			return [
				{ "speaker": "", "text": "〔仮テキスト〕夕方。あの崖の上へ行くと、由布は先に来て、膝を抱えて座っていた。" },
				{ "speaker": "由布", "text": "待ってた。……ちゃんと、約束の時間ね。" },
				{ "speaker": "由布", "text": "この前の続き。……ほら、もうすぐ。日が沈んだ、そのあと。" },
				{ "speaker": "", "text": "陽が落ちると、町に一つずつ灯りがともりはじめた。まるで、誰かが星を下ろしていくみたいに。" },
				{ "speaker": "由布", "text": "これを、あなたと見たかったの。……覚えていてね。この景色も、今日のことも。" },
			]
	return _generic(character)


## 個別の台本が無い約束（旧セーブ・今後足す約束の仮置き）。会えたこと自体を短く描く。
static func _generic(character: String) -> Array:
	match character:
		"kuma":
			return [
				{ "speaker": "球磨", "text": "〔仮テキスト〕お、約束どおりだな！　よし、今日はとことん遊ぶぞ。" },
				{ "speaker": "", "text": "日が傾くまで、球磨と二人で過ごした。" },
			]
		"yufu":
			return [
				{ "speaker": "由布", "text": "〔仮テキスト〕……来てくれた。ちゃんと、約束の時間に。" },
				{ "speaker": "", "text": "由布と、静かな時間を過ごした。" },
			]
		"aoi":
			return [
				{ "speaker": "葵", "text": "〔仮テキスト〕へへ、来てくれたんだ。……約束、だもんね。" },
			]
	return [ { "speaker": "", "text": "〔仮テキスト〕約束どおりの時間が、静かに過ぎていった。" } ]
