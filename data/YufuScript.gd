# --- 8/31 の三分岐エンディング（Endings から呼ぶ）----------------------
## §2-1：三つは対等。優劣・正解・失敗はない。着地2（yufu_end_friend）も失敗ではなく、
##   留まりたい子が変化を恐れた切ない帰結として肯定的に締める（§5）。
## §2-4：本文は完成済み。三つが正しく判定され再生されることを実装する。
static func ending(end_id: String) -> Array:
	match end_id:
		Endings.YUFU_END_CROSS:
			return _end_cross()
		Endings.YUFU_END_FRIEND:
			return _end_friend()
		Endings.YUFU_END_BESIDE:
			return _end_beside()
	return []


